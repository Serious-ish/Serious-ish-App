# Moderation page settings. Copy to .env.local for local development.
# NEXT_PUBLIC_ values are sent to the browser and are PUBLIC.
# The page never holds a Supabase secret key: staff read through narrow database
# functions under their own two-step login (TRD 7.5). See the root README for owners.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
SESSION_COOKIE_NAME=
SITE_URL=

# Build secret: set in Vercel and GitHub only, never in a local file that is shared.
SENTRY_AUTH_TOKEN=
