# Dependencies
node_modules/

# Environment files: real values never enter the repository (TRD 07).
# Only the .env.example files, which hold names with empty values, are committed.
.env
.env.*
!.env.example

# Build output
dist/
build/
coverage/
*.tsbuildinfo

# Supabase local state
supabase/.temp/
supabase/.branches/

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
.vercel
