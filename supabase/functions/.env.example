# Edge Function secrets (TRD 7.3). For LOCAL use: copy to supabase/functions/.env with
# vendor SANDBOX keys only. Staging and production values are set with
# `supabase secrets set --project-ref <ref>` and exist only on Supabase's servers.
# All of these are SECRET. None may ever appear in the app, the moderation page or the repository.

SUPABASE_SECRET_KEY=
VERIFICATION_VENDOR_API_KEY=
VERIFICATION_WEBHOOK_SECRET=
VERIFICATION_TEMPLATE_ID=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ca-central-1
RESEND_API_KEY=
EMAIL_FROM=
MODERATOR_ALERT_EMAILS=
MODERATION_BASE_URL=
EXPO_ACCESS_TOKEN=
EVIDENCE_KEY_REF=
AGE_PASS_THRESHOLD=21
AGE_REVIEW_FLOOR=18
